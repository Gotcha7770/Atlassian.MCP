<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>atlassian-mcp</ToolCommandName>
    <PackageId>Atlassian.MCP.Server</PackageId>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14"/>
    <PackageReference Include="ModelContextProtocol" Version="2.3.1"/>
    <PackageReference Include="Spectre.Console" Version="0.57.2"/>
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atlassian.Mcp.Infrastructure\Atlassian.Mcp.Infrastructure.csproj"/>
  </ItemGroup>

</Project>
